        "use_when": "company valuation"
      },
      {
        "path": "?function=NEWS_SENTIMENT&tickers={ticker}&apikey={key}",
        "returns": "News articles with sentiment scores",
        "use_when": "stock sentiment"
      },
      {
        "path": "?function=TIME_SERIES_MONTHLY&symbol={ticker}&apikey={key}",
        "returns": "Monthly OHLCV for 20+ years",
        "use_when": "long-term stock analysis"
      }
    ],
    "notes": "Free: 25/day. Key: get free at alphavantage.co/support"
  },
  {

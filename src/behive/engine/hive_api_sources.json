    "notes": "Free tier: 200 req/min. Real-time WebSocket available."
  },
  {
    "name": "Polygon.io",
    "url": "https://api.polygon.io",
    "category": "stocks",
    "auth": "apiKey",
    "query_type": "market_data",
    "endpoints": [
      {
        "path": "/v2/aggs/ticker/{ticker}/range/1/day/{from}/{to}?apiKey={key}",
        "returns": "OHLCV daily bars",
        "use_when": "stock price history"
      },
      {
        "path": "/v3/reference/tickers?search={query}&apiKey={key}",
        "returns": "Ticker search results with company info",
        "use_when": "find stock tickers"
      },
      {
        "path": "/v2/snapshot/locale/us/markets/stocks/tickers?apiKey={key}",
        "returns": "Real-time snapshot of all US stocks",
        "use_when": "market overview"
      }
    ],
    "notes": "Free: 5 API calls/min. Delayed data. {from}/{to} = YYYY-MM-DD"
  },
  {
    "name": "Alpha Vantage",
    "url": "https://www.alphavantage.co/query",
    "category": "stocks",
    "auth": "apiKey",
    "query_type": "market_data",
    "endpoints": [
      {
        "path": "?function=GLOBAL_QUOTE&symbol={ticker}&apikey={key}",
        "returns": "Latest price, volume, change for a stock",
        "use_when": "current stock price"
      },
      {
        "path": "?function=OVERVIEW&symbol={ticker}&apikey={key}",

[
  {
    "name": "CoinGecko",
    "url": "https://api.coingecko.com/api/v3",
    "category": "crypto",
    "auth": "none",
    "query_type": "market_data",
    "endpoints": [
      {
        "path": "/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=50",
        "returns": "Top 50 coins: price, market_cap, volume, 24h change",
        "use_when": "crypto market overview"
      },
      {
        "path": "/coins/{id}",
        "returns": "Full coin data: description, links, market data, community stats",
        "use_when": "deep dive on specific crypto"
      },
      {
        "path": "/coins/{id}/market_chart?vs_currency=usd&days=30",
        "returns": "Price/volume/market_cap arrays for charting",
        "use_when": "price history"
      },
      {
        "path": "/search/trending",
        "returns": "Top 7 trending coins in last 24h",
        "use_when": "crypto trends"
      },
      {
        "path": "/global",
        "returns": "Total market cap, volume, BTC dominance",
        "use_when": "macro crypto metrics"
      }
    ],
    "notes": "Rate limit: 10-30/min free. {id} = 'bitcoin', 'ethereum', etc."
  },
  {
    "name": "CoinCap",
    "url": "https://api.coincap.io/v2",
    "category": "crypto",
    "auth": "none",
    "query_type": "market_data",
    "endpoints": [
      {
        "path": "/assets",
        "returns": "Top 100 crypto assets with real-time prices",
        "use_when": "crypto rankings"
      },
      {
        "path": "/assets/{id}/history?interval=d1",
        "returns": "Daily price history",
        "use_when": "crypto price trends"
      },
      {
        "path": "/exchanges",
        "returns": "Exchange list with volume data",
        "use_when": "exchange comparison"
      }

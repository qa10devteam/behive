# ═══════════════════════════════════════════════════════════════════
# BeHive Configuration
# cp .env.example .env && edit values && docker compose up -d
# ═══════════════════════════════════════════════════════════════════

# ─── LLM Provider ─────────────────────────────────────────────────
# Required: at least one LLM key for claim extraction and synthesis
LLM_PROVIDER=anthropic

# Anthropic (recommended — Claude Haiku for bulk, Sonnet for synthesis)
ANTHROPIC_API_KEY=

# OpenAI (alternative)
# OPENAI_API_KEY=

# AWS Bedrock (high throughput, multi-region)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Local LLM (SGLang/vLLM/Ollama — advanced, requires GPU)
# LOCAL_LLM_URL=http://host.docker.internal:8080/v1

# ─── Security ─────────────────────────────────────────────────────
# API authentication (optional for localhost, REQUIRED for public deployments)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BEHIVE_API_KEY=

# CORS origins (comma-separated, default: * for local dev)
# BEHIVE_CORS_ORIGINS=https://yourdomain.com

# ─── Database ─────────────────────────────────────────────────────
# Generate strong password: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-to-strong-password

# Full connection URL (overrides individual vars)
# DATABASE_URL=postgresql://behive:***@localhost:5432/behive

# ─── Knowledge Graph ─────────────────────────────────────────────
# Only needed with --profile full (enables Neo4j + Qdrant)
NEO4J_PASSWORD=change-me-to-strong-password

# ─── Ports ────────────────────────────────────────────────────────
BEHIVE_PORT=8091
BEHIVE_MCP_PORT=8090
POSTGRES_PORT=5433
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_PORT=6333

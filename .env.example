# BeHive Configuration
# cp .env.example .env && docker compose up -d

# LLM Provider: openai | anthropic | bedrock | local
LLM_PROVIDER=openai

# OpenAI (default provider)
OPENAI_API_KEY=sk-your-key-here

# Anthropic (Claude Haiku + Sonnet)
# ANTHROPIC_API_KEY=sk-ant-your-key

# AWS Bedrock (high throughput)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Local LLM (SGLang/vLLM/Ollama)
# LOCAL_LLM_URL=http://host.docker.internal:8080/v1

# Database
POSTGRES_PASSWORD=behive2026

# Knowledge Graph (docker compose --profile full up)
NEO4J_PASSWORD=behive2026

# Ports
BEHIVE_PORT=8091
POSTGRES_PORT=5433
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_PORT=6333

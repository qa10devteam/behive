# BeHive Configuration
# Copy this to .env and fill in your values

# ═══ REQUIRED ═══════════════════════════════════════════════════════════════════

# LLM Provider (pick at least one)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...

# Database (PostgreSQL)
BEHIVE_DB_URL=postgresql://behive:behive@localhost:5432/behive
# Or individual vars:
# HIVE_PG_USER=behive
# HIVE_PG_PASSWORD=behive
# HIVE_PG_HOST=localhost
# HIVE_PG_PORT=5432
# HIVE_PG_DATABASE=behive

# ═══ OPTIONAL ═══════════════════════════════════════════════════════════════════

# Custom model (any litellm string — see https://docs.litellm.ai/docs/providers)
# BEHIVE_MODEL=anthropic/claude-sonnet-4-20250514
# BEHIVE_MODEL=openai/gpt-4o
# BEHIVE_MODEL=groq/llama-3.3-70b-versatile
# BEHIVE_MODEL=ollama/qwen2.5:32b

# Server
# BEHIVE_HOST=0.0.0.0
# BEHIVE_PORT=8091
# BEHIVE_MCP_PORT=8090
# BEHIVE_AUTH_TOKEN=  # Set to require Bearer auth on API

# Concurrency & Timeouts
# BEHIVE_MAX_CONCURRENT=3
# BEHIVE_PHASE_TIMEOUT=600
# BEHIVE_SCOUT_TIMEOUT=300
# BEHIVE_FALSIFIER_TIMEOUT=1200

# Knowledge Graph (optional)
# BEHIVE_NEO4J_URI=bolt://localhost:7687
# BEHIVE_NEO4J_PASSWORD=your-neo4j-password

# Vector Search (optional)
# BEHIVE_QDRANT_URL=http://localhost:6333

# Reports
# BEHIVE_REPORTS_DIR=~/hive-reports
